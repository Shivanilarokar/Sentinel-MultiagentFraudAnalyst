# Sentinel - environment
# Copy to .env and fill in. Only the first line is required.

# ---------------------------------------------------------------------------
# Model access (required)
# ---------------------------------------------------------------------------
OPENAI_API_KEY=sk-...

# ---------------------------------------------------------------------------
# Models (optional - these are the defaults)
# ---------------------------------------------------------------------------
# Two tiers. The specialists run four times per account across 276 accounts,
# so they carry the cheap model. The supervisor and disposition officer weigh
# conflicting evidence and write the text that gets read, so they carry the
# better one.
SENTINEL_SPECIALIST_MODEL=gpt-4.1-mini
SENTINEL_SUPERVISOR_MODEL=gpt-4.1

# ---------------------------------------------------------------------------
# Sweep (optional)
# ---------------------------------------------------------------------------
# Accounts processed concurrently. Each gets its own supervisor invocation and
# its own message list; they share nothing.
SENTINEL_SWEEP_WORKERS=8

# ---------------------------------------------------------------------------
# Tracing (optional)
# ---------------------------------------------------------------------------
# Off by default, so the repository runs with only an OpenAI key. Turn it on
# to inspect each specialist's isolated message list in LangSmith.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=lsv2_pt_...
LANGSMITH_PROJECT=sentinel-fraud-triage
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
